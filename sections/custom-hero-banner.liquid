<div class="custom-hero-container">

  <!-- TOP HEADER BAR (Clean, solid bar) -->
  <header class="hero-top-header">
    <div class="hero-brand">
      <a href="/" class="brand-link">{{ section.settings.brand_name }}</a>
    </div>

    <div class="hero-announcement">
      <span>{{ section.settings.announcement_text }}</span>
    </div>

    <div class="hero-action">
      <a href="{{ section.settings.top_button_link }}" class="yellow-cta-btn">
        <span>{{ section.settings.top_button_text }}</span>
        <span class="btn-arrow">&rarr;</span>
      </a>
    </div>
  </header>

  <!-- TOP LINE-ART BANNER (Directly below header) -->
  <div class="hero-top-illustration">
    <img src="{{ 'hero-banner1-bg.svg' | asset_url }}" alt="" loading="eager">
  </div>

  <!-- LOWER BANNER WITH OVERLAY TEXT -->
  <div class="hero-lower-banner">
    <!-- Left Area: Clean Content Area -->
    <div class="hero-left-area">
      <h1 class="hero-heading">{{ section.settings.heading }}</h1>
      <p class="hero-subtext">{{ section.settings.description }}</p>
      <a href="{{ section.settings.cta_button_link }}" class="main-cta-btn">
        <span>{{ section.settings.cta_button_text }}</span>
        <span class="btn-arrow">&rarr;</span>
      </a>
    </div>

    <!-- Right Area: SVG Illustration -->
    <div class="hero-right-area">
      <img src="{{ 'hero-banner2-bg.svg' | asset_url }}" alt="Gift Guide Illustration" loading="eager" width="100%" height="100%">
    </div>
  </div>

  <!-- Bottom Ticker -->
  {% if section.settings.footer_ticker_text != blank %}
    <div class="hero-bottom-ticker">
      <span>{{ section.settings.footer_ticker_text }}</span>
    </div>
  {% endif %}

</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700;800&display=swap');

  .custom-hero-container {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    background: #FFFFFF;
    font-family: 'Jost', sans-serif;
    position: relative;
    box-sizing: border-box;
    overflow: hidden;
  }

  /* --------------------------------------
     TOP HEADER (Solid White/Gray Bar)
  -------------------------------------- */
  .hero-top-header {
    width: 100%;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 40px;
    box-sizing: border-box;
    background-color: #F7F7F7;
    position: relative;
    z-index: 10;
  }

  .brand-link {
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: #000000;
    text-decoration: none;
    text-transform: uppercase;
  }

  .hero-announcement {
    font-size: 13px;
    font-weight: 400;
    color: #000000;
  }

  .yellow-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background-color: #FFEE4A;
    color: #000000;
    padding: 8px 18px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-decoration: none;
    text-transform: uppercase;
  }

  /* --------------------------------------
     TOP ILLUSTRATION SECTION
  -------------------------------------- */
  .hero-top-illustration {
    width: 100%;
    background-color: #F7F7F7;
    line-height: 0;
  }

  .hero-top-illustration img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* --------------------------------------
     LOWER MAIN BANNER & TEXT OVERLAY
  -------------------------------------- */
  .hero-lower-wrapper {
    position: relative;
    width: 100%;
    min-height: 420px;
    background-color: #FFFFFF;
  }

  .hero-bg-illustration {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-bg-illustration img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
    display: block;
  }

  .hero-text-overlay {
    position: relative;
    z-index: 2;
    max-width: 460px;
    padding: 60px 0 60px 50px;
    background: #FFFFFF; /* Masks out line art behind the text block */
  }

  .hero-heading {
    font-family: 'Jost', sans-serif;
    font-weight: 600;
    font-size: 64px;
    line-height: 1.05;
    color: #000000;
    margin: 0 0 20px 0;
  }

  .hero-subtext {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 15px;
    line-height: 1.4;
    color: #000000;
    margin: 0 0 28px 0;
  }

  .main-cta-btn {
    width: 180px;
    height: 46px;
    background-color: #000000;
    color: #FFFFFF;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
    box-sizing: border-box;
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  /* --------------------------------------
     BOTTOM TICKER
  -------------------------------------- */
  .hero-bottom-ticker {
    width: 100%;
    text-align: center;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.8px;
    padding: 12px 0;
    border-top: 1px solid #EAEAEA;
    background-color: #F7F7F7;
    text-transform: uppercase;
    position: relative;
    z-index: 5;
  }

  /* --------------------------------------
     RESPONSIVE BREAKPOINTS
  -------------------------------------- */
  @media (max-width: 900px) {
    .hero-top-header {
      flex-direction: column;
      height: auto;
      gap: 10px;
      padding: 15px;
    }

    .hero-text-overlay {
      max-width: 100%;
      padding: 30px 20px;
    }

    .hero-heading {
      font-size: 42px;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Hero Banner",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand Name", "default": "TISSO VISON" },
    { "type": "inline_richtext", "id": "announcement_text", "label": "Announcement Text", "default": "Find the ideal gift for your loved ones." },
    { "type": "text", "id": "top_button_text", "label": "Top Button Text", "default": "CHOOSE GIFT" },
    { "type": "url", "id": "top_button_link", "label": "Top Button Link" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "The Gift Guide" },
    { "type": "text", "id": "description", "label": "Description", "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season." },
    { "type": "text", "id": "cta_button_text", "label": "CTA Button Text", "default": "SHOP NOW" },
    { "type": "url", "id": "cta_button_link", "label": "CTA Button Link" },
    { "type": "text", "id": "footer_ticker_text", "label": "Footer Ticker Text", "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL" }
  ],
  "presets": [{ "name": "Custom Hero Banner" }]
}
{% endschema %}