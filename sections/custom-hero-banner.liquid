<div class="custom-hero-container">
  <!-- Top Banner Bar -->
  <div class="hero-top-banner" style="background-image: url('{{ 'hero-banner1-bg.svg' | asset_url }}');">
    <div class="hero-brand">{{ section.settings.brand_name }}</div>
    <div class="hero-announcement-content">
      <span class="announcement-text">{{ section.settings.announcement_text }}</span>
      <a href="{{ section.settings.top_button_link }}" class="btn-animated top-btn">
        {{ section.settings.top_button_text }} &rarr;
      </a>
    </div>
  </div>

  <!-- Lower Banner: Image is set behind the text across the full width -->
  <div class="hero-lower-banner" style="background-image: url('{{ 'hero-banner2-bg.svg' | asset_url }}');">
    <div class="hero-text-card">
      <h1 class="hero-heading">{{ section.settings.heading }}</h1>
      <div class="hero-subtext">{{ section.settings.description }}</div>
      <a href="{{ section.settings.cta_button_link }}" class="btn-animated main-cta-btn">
        {{ section.settings.cta_button_text }} &rarr;
      </a>
    </div>
  </div>

  <!-- Bottom Ticker -->
  {% if section.settings.footer_ticker_text != blank %}
    <div class="hero-bottom-ticker">
      {{ section.settings.footer_ticker_text }}
    </div>
  {% endif %}
</div>

<style>
  .custom-hero-container {
    width: 100%;
    background-color: #ffffff;
    box-sizing: border-box;
  }

  /* Top Banner Bar */
  .hero-top-banner {
    width: 100%;
    height: 390px;
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 24px 5%;
    box-sizing: border-box;
  }

  .hero-brand {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 2px;
    color: #000;
  }

  .hero-announcement-content {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .announcement-text {
    font-size: 14px;
    color: #000;
  }

  /* Lower Section with Background Behind Text */
  .hero-lower-banner {
    width: 100%;
    min-height: 402px;
    background-size: cover;
    background-position: left center;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    position: relative;
    box-sizing: border-box;
  }

  /* Transparent Text Container allows the background image to show through */
  .hero-text-card {
    width: 40%;
    background: transparent;
    padding: 40px 0 40px 5%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
    z-index: 2;
  }

  .hero-heading {
    font-size: 48px;
    font-weight: 700;
    margin: 0 0 16px 0;
    line-height: 1.1;
    color: #000000;
  }

  .hero-subtext {
    font-size: 14px;
    color: #333333;
    margin-bottom: 28px;
    line-height: 1.6;
  }

  /* Buttons & Hover Animation */
  .btn-animated {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .top-btn {
    background-color: #f6e05e;
    color: #000;
  }

  .main-cta-btn {
    background-color: #000000;
    color: #ffffff;
    width: fit-content;
  }

  .btn-animated:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.2);
  }

  /* Bottom Ticker */
  .hero-bottom-ticker {
    text-align: center;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 12px 0;
    border-top: 1px solid #eaeaea;
    background: #fff;
  }

  @media (max-width: 768px) {
    .hero-top-banner {
      flex-direction: column;
      align-items: center;
      height: auto;
      min-height: 250px;
      gap: 15px;
    }
    .hero-text-card {
      width: 100%;
      padding: 40px 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Hero Banner",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand Name", "default": "TISSO VISON" },
    { "type": "inline_richtext", "id": "announcement_text", "label": "Announcement Text", "default": "Find the ideal gift for your loved ones." },
    { "type": "text", "id": "top_button_text", "label": "Top Button Text", "default": "CHOOSE GIFT" },
    { "type": "url", "id": "top_button_link", "label": "Top Button Link" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "The Gift Guide" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>" },
    { "type": "text", "id": "cta_button_text", "label": "CTA Button Text", "default": "SHOP NOW" },
    { "type": "url", "id": "cta_button_link", "label": "CTA Button Link" },
    { "type": "text", "id": "footer_ticker_text", "label": "Footer Ticker Text", "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL" }
  ],
  "presets": [{ "name": "Custom Hero Banner" }]
}
{% endschema %}