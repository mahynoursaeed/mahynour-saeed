<div class="custom-hero-container">

  <!-- TOP HEADER BAR (Clean, solid bar) -->
  <header class="hero-top-header">
    <div class="hero-brand">
      <a href="/" class="brand-link">{{ section.settings.brand_name }}</a>
    </div>

    <div class="hero-announcement">
      <span>{{ section.settings.announcement_text }}</span>
    </div>

    <div class="hero-action">
      <a href="{{ section.settings.top_button_link }}" class="yellow-cta-btn">
        <span>{{ section.settings.top_button_text }}</span>
        <span class="btn-arrow">&rarr;</span>
      </a>
    </div>
  </header>

  <!-- TOP LINE-ART BANNER (Directly below header) -->
  <div class="hero-top-illustration">
    <img src="{{ 'hero-banner1-bg.svg' | asset_url }}" alt="" loading="eager">
  </div>

  <!-- LOWER BANNER WITH OVERLAY TEXT -->
<!-- LOWER MAIN SECTION -->
  <div class="hero-lower-wrapper">
    <!-- Clean left content box masking out background art -->
    <div class="hero-left-content">
      <h1 class="hero-heading">{{ section.settings.heading }}</h1>
      <p class="hero-subtext">{{ section.settings.description }}</p>
      <a href="{{ section.settings.cta_button_link }}" class="main-cta-btn">
        <span>{{ section.settings.cta_button_text }}</span>
        <span class="btn-arrow">&rarr;</span>
      </a>
    </div>

    <!-- Right-aligned vector artwork layer -->
    <div class="hero-right-illustration">
      <img src="{{ 'hero-banner2-bg.svg' | asset_url }}" alt="Gift Guide Illustration" loading="eager" width="100%" height="auto">
    </div>
  </div>

  <!-- BOTTOM TICKER -->
  {% if section.settings.footer_ticker_text != blank %}
    <div class="hero-bottom-ticker">
      <span>{{ section.settings.footer_ticker_text }}</span>
    </div>
  {% endif %}

</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700;800&display=swap');

  .custom-hero-container {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    background: #F7F7F7;
    font-family: 'Jost', sans-serif;
    position: relative;
    box-sizing: border-box;
    overflow: hidden;
  }

  /* --------------------------------------
     1. TOP HEADER (Isolated from SVG)
  -------------------------------------- */
  .hero-top-header {
    width: 100%;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 40px;
    box-sizing: border-box;
    background-color: #F7F7F7;
    position: relative;
    z-index: 20;
  }

  .brand-link {
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: #000000;
    text-decoration: none;
    text-transform: uppercase;
  }

  .hero-announcement {
    font-size: 13px;
    font-weight: 400;
    color: #000000;
  }

  .yellow-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: #FFEE4A;
    color: #000000;
    padding: 8px 16px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-decoration: none;
    text-transform: uppercase;
  }

  /* --------------------------------------
     2. TOP VECTOR ARTWORK
  -------------------------------------- */
  .hero-top-illustration {
    width: 100%;
    background-color: #F7F7F7;
    line-height: 0;
    position: relative;
    z-index: 1;
  }

  .hero-top-illustration img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* --------------------------------------
     3. LOWER BANNER SECTION
  -------------------------------------- */
  .hero-lower-wrapper {
    position: relative;
    width: 100%;
    display: flex;
    align-items: flex-start;
    background-color: #FFFFFF;
    overflow: hidden;
  }

  /* Left text content card */
  .hero-left-content {
    position: relative;
    z-index: 10;
    width: 42%;
    min-width: 480px;
    padding: 40px 0 60px 40px;
    background: #FFFFFF;
    box-sizing: border-box;
  }

  /* Keep heading on one single line */
  .hero-heading {
    font-family: 'Jost', sans-serif;
    font-weight: 600;
    font-size: 56px;
    line-height: 1;
    color: #000000;
    margin: 0 0 20px 0;
    white-space: nowrap;
  }

  .hero-subtext {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 1.45;
    color: #000000;
    max-width: 380px;
    margin: 0 0 28px 0;
  }

  .main-cta-btn {
    width: 170px;
    height: 44px;
    background-color: #000000;
    color: #FFFFFF;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 18px;
    box-sizing: border-box;
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  /* Right vector artwork container */
  .hero-right-illustration {
    width: 58%;
    line-height: 0;
    background-color: #FFFFFF;
  }

  .hero-right-illustration img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* --------------------------------------
     4. BOTTOM TICKER
  -------------------------------------- */
  .hero-bottom-ticker {
    width: 100%;
    text-align: center;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.8px;
    padding: 12px 0;
    border-top: 1px solid #EAEAEA;
    background-color: #F7F7F7;
    text-transform: uppercase;
    position: relative;
    z-index: 10;
  }

  /* --------------------------------------
     RESPONSIVE BREAKPOINTS
  -------------------------------------- */
  @media (max-width: 1024px) {
    .hero-heading {
      white-space: normal;
      font-size: 44px;
    }

    .hero-left-content {
      width: 100%;
      min-width: unset;
      padding: 30px 20px;
    }

    .hero-lower-wrapper {
      flex-direction: column;
    }

    .hero-right-illustration {
      width: 100%;
    }

    .hero-top-header {
      flex-direction: column;
      height: auto;
      gap: 10px;
      padding: 15px;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Hero Banner",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand Name", "default": "TISSO VISON" },
    { "type": "inline_richtext", "id": "announcement_text", "label": "Announcement Text", "default": "Find the ideal gift for your loved ones." },
    { "type": "text", "id": "top_button_text", "label": "Top Button Text", "default": "CHOOSE GIFT" },
    { "type": "url", "id": "top_button_link", "label": "Top Button Link" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "The Gift Guide" },
    { "type": "text", "id": "description", "label": "Description", "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season." },
    { "type": "text", "id": "cta_button_text", "label": "CTA Button Text", "default": "SHOP NOW" },
    { "type": "url", "id": "cta_button_link", "label": "CTA Button Link" },
    { "type": "text", "id": "footer_ticker_text", "label": "Footer Ticker Text", "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL" }
  ],
  "presets": [{ "name": "Custom Hero Banner" }]
}
{% endschema %}