{{ 'custom-hotspot.js' | asset_url | script_tag }}

<div class="hotspot-grid-wrapper">
  <h2 class="grid-title">{{ section.settings.section_title }}</h2>

  <div class="photo-grid">
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}
      <div class="grid-card" {{ block.shopify_attributes }}>
        {% if product != blank and product.featured_image != blank %}
          <img 
            src="{{ product.featured_image | image_url: width: 800 }}" 
            alt="{{ product.title | escape }}" 
            width="{{ product.featured_image.width }}" 
            height="{{ product.featured_image.height }}" 
            loading="lazy" 
            class="grid-img"
          >
        {% elsif block.settings.custom_image != blank %}
          <img 
            src="{{ block.settings.custom_image | image_url: width: 800 }}" 
            alt="{{ section.settings.section_title | escape }}" 
            width="{{ block.settings.custom_image.width }}" 
            height="{{ block.settings.custom_image.height }}" 
            loading="lazy" 
            class="grid-img"
          >
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}

        {% if product != blank %}
          <button 
            type="button"
            class="hotspot-pin" 
            style="top: {{ block.settings.hotspot_y }}%; left: {{ block.settings.hotspot_x }}%;"
            data-handle="{{ product.handle }}"
            aria-label="View {{ product.title | escape }}"
          >
            +
          </button>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

<!-- Dynamic Hotspot Modal -->
<div id="hotspot-modal-overlay" class="modal-overlay" aria-hidden="true">
  <div class="modal-box">
    <button type="button" id="modal-close-trigger" class="modal-close-btn" aria-label="Close modal">&times;</button>
    <div class="modal-content">
      <img id="modal-target-img" src="" alt="" width="200" height="240" class="modal-img">
      <div class="modal-info">
        <h3 id="modal-target-title" class="modal-title">Loading...</h3>
        <p id="modal-target-price" class="modal-price"></p>
        <div id="modal-target-desc" class="modal-desc"></div>

        <div id="modal-options-container"></div>

        <form id="hotspot-add-to-cart-form">
          <input type="hidden" id="modal-selected-variant-id" name="id" value="">
          <button type="submit" id="modal-atc-submit" class="modal-atc-btn">
            ADD TO CART <span>&rarr;</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const overlay = document.getElementById('hotspot-modal-overlay');
    const closeBtn = document.getElementById('modal-close-trigger');
    const form = document.getElementById('hotspot-add-to-cart-form');
    
    let currentProduct = null;
    let selectedOptions = {};

    document.querySelectorAll('.hotspot-pin').forEach(pin => {
      pin.addEventListener('click', async function() {
        const handle = this.getAttribute('data-handle');
        if (!handle) return;

        // Reset Modal State
        document.getElementById('modal-target-title').innerText = 'Loading...';
        document.getElementById('modal-target-price').innerText = '';
        document.getElementById('modal-target-desc').innerText = '';
        document.getElementById('modal-target-img').src = '';
        document.getElementById('modal-options-container').innerHTML = '';

        overlay.classList.add('active');
        overlay.setAttribute('aria-hidden', 'false');

        try {
          const rootUrl = '{{ routes.root_url }}'.endsWith('/') ? '{{ routes.root_url }}' : '{{ routes.root_url }}/';
          const response = await fetch(`${rootUrl}products/${handle}.js`);
          if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
          currentProduct = await response.json();
        } catch (e) {
          console.error('Error fetching product JSON:', e);
          document.getElementById('modal-target-title').innerText = 'Error loading product';
          return;
        }

        selectedOptions = {};

        // Populate Title
        document.getElementById('modal-target-title').innerText = currentProduct.title || '';

        // Populate Price
        const priceVal = currentProduct.price || (currentProduct.variants && currentProduct.variants[0] ? currentProduct.variants[0].price : 0);
        const priceInUnits = (priceVal / 100).toFixed(2);
        document.getElementById('modal-target-price').innerText = `$${priceInUnits}`;

        // Populate Description
        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = currentProduct.description || '';
        document.getElementById('modal-target-desc').innerText = tempDiv.innerText || tempDiv.textContent || '';

        // Populate Image
        const imgUrl = currentProduct.featured_image || (currentProduct.images && currentProduct.images[0]);
        document.getElementById('modal-target-img').src = imgUrl || '';

        renderProductOptions(currentProduct);
      });
    });

    closeBtn.addEventListener('click', closeModal);
    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) closeModal();
    });

    function closeModal() {
      overlay.classList.remove('active');
      overlay.setAttribute('aria-hidden', 'true');
    }

    function renderProductOptions(product) {
      const container = document.getElementById('modal-options-container');
      container.innerHTML = '';

      if (!product.options || product.options.length === 0 || (product.options.length === 1 && product.options[0].name === 'Title')) {
        if (product.variants && product.variants.length > 0) {
          document.getElementById('modal-selected-variant-id').value = product.variants[0].id;
        }
        return;
      }

      product.options.forEach((optionObj, idx) => {
        const optName = typeof optionObj === 'string' ? optionObj : optionObj.name;
        const optionValues = typeof optionObj === 'object' && optionObj.values ? optionObj.values : [...new Set(product.variants.map(v => v.options[idx]))];

        const optionWrapper = document.createElement('div');
        optionWrapper.className = 'modal-option-group';

        const label = document.createElement('label');
        label.className = 'option-label';
        label.innerText = optName;
        optionWrapper.appendChild(label);

        selectedOptions[optName] = optionValues[0];

        if (optName.toLowerCase() === 'color' || optName.toLowerCase() === 'colour') {
          const colorGroup = document.createElement('div');
          colorGroup.className = 'color-options';
          
          optionValues.forEach((val, valIndex) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = `color-btn ${valIndex === 0 ? 'active' : ''}`;
            btn.innerText = val;
            btn.addEventListener('click', function() {
              colorGroup.querySelectorAll('.color-btn').forEach(b => b.classList.remove('active'));
              this.classList.add('active');
              selectedOptions[optName] = val;
              updateVariantSelection();
            });
            colorGroup.appendChild(btn);
          });
          optionWrapper.appendChild(colorGroup);
        } else {
          const customDropdown = document.createElement('div');
          customDropdown.className = 'custom-dropdown';

          const selectedDiv = document.createElement('div');
          selectedDiv.className = 'dropdown-selected';
          selectedDiv.innerHTML = `<span>Choose your size</span><span class="dropdown-arrow">▼</span>`;

          const menuDiv = document.createElement('div');
          menuDiv.className = 'dropdown-menu';

          optionValues.forEach((val) => {
            const itemDiv = document.createElement('div');
            itemDiv.className = 'dropdown-item';
            itemDiv.innerText = val;

            itemDiv.addEventListener('click', function() {
              menuDiv.querySelectorAll('.dropdown-item').forEach(i => i.classList.remove('selected'));
              this.classList.add('selected');
              selectedDiv.querySelector('span').innerText = val;
              selectedOptions[optName] = val;
              customDropdown.classList.remove('open');
              updateVariantSelection();
            });

            menuDiv.appendChild(itemDiv);
          });

          selectedDiv.addEventListener('click', function(e) {
            e.stopPropagation();
            customDropdown.classList.toggle('open');
          });

          document.addEventListener('click', function() {
            customDropdown.classList.remove('open');
          });

          customDropdown.appendChild(selectedDiv);
          customDropdown.appendChild(menuDiv);
          optionWrapper.appendChild(customDropdown);
        }

        container.appendChild(optionWrapper);
      });

      updateVariantSelection();
    }

    function updateVariantSelection() {
      if (!currentProduct || !currentProduct.variants) return;

      const matchedVariant = currentProduct.variants.find(variant => {
        return currentProduct.options.every((optionObj, idx) => {
          const optName = typeof optionObj === 'string' ? optionObj : optionObj.name;
          return variant.options[idx] === selectedOptions[optName];
        });
      });

      const atcBtn = document.getElementById('modal-atc-submit');
      if (matchedVariant && matchedVariant.available) {
        document.getElementById('modal-selected-variant-id').value = matchedVariant.id;
        atcBtn.disabled = false;
        atcBtn.innerHTML = 'ADD TO CART <span>&rarr;</span>';
      } else {
        document.getElementById('modal-selected-variant-id').value = '';
        atcBtn.disabled = true;
        atcBtn.innerText = 'UNAVAILABLE';
      }
    }

    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      const variantId = document.getElementById('modal-selected-variant-id').value;
      if (!variantId) return;

      const itemsToAdd = [{ id: parseInt(variantId), quantity: 1 }];

      const optionValues = Object.values(selectedOptions).map(v => String(v).toLowerCase());
      const isBlackAndMedium = optionValues.includes('black') && (optionValues.includes('medium') || optionValues.includes('m'));

      if (isBlackAndMedium) {
        try {
          const rootUrl = '{{ routes.root_url }}'.endsWith('/') ? '{{ routes.root_url }}' : '{{ routes.root_url }}/';
          const searchRes = await fetch(`${rootUrl}search/suggest.json?q=Soft%20Winter%20Jacket&resources[type]=product`);
          const searchData = await searchRes.json();
          const jacketProduct = searchData.resources.results.products[0];

          if (jacketProduct && jacketProduct.variants && jacketProduct.variants[0]) {
            itemsToAdd.push({ id: jacketProduct.variants[0].id, quantity: 1 });
          }
        } catch (err) {
          console.error('Failed to query bonus jacket:', err);
        }
      }

      fetch('{{ routes.cart_add_url }}.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: itemsToAdd })
      })
      .then(res => res.json())
      .then(() => {
        closeModal();
        window.location.href = '{{ routes.cart_url }}';
      })
      .catch(err => console.error('Cart add failed:', err));
    });
  });
</script>

<style>
  .hotspot-grid-wrapper {
    padding: 60px 5%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .grid-title {
    font-size: 28px;
    font-weight: 400;
    margin-bottom: 30px;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  @media (max-width: 768px) {
    .photo-grid {
      grid-template-columns: repeat(1, 1fr);
    }
  }

  .grid-card {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background-color: #f5f5f5;
  }

  .grid-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hotspot-pin {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(0, 0, 0, 0.1);
    font-size: 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }

  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    z-index: 9999;
  }

  .modal-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .modal-box {
    background: #fff;
    padding: 32px 24px 24px;
    max-width: 440px;
    width: 90%;
    position: relative;
  }

  .modal-close-btn {
    position: absolute;
    top: 8px;
    right: 12px;
    background: none;
    border: none;
    font-size: 20px;
    cursor: pointer;
  }

  .modal-content {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 16px;
  }

  @media (max-width: 480px) {
    .modal-content {
      grid-template-columns: 1fr;
    }
  }

  .modal-img {
    width: 100%;
    height: auto;
    aspect-ratio: 4/5;
    object-fit: cover;
  }

  .modal-title {
    font-size: 15px;
    font-weight: 500;
    margin: 0 0 6px;
  }

  .modal-price {
    font-size: 14px;
    margin: 0 0 10px;
  }

  .modal-desc {
    font-size: 11px;
    line-height: 1.4;
    color: #666;
    margin: 0 0 16px;
  }

  .modal-option-group {
    margin-bottom: 12px;
  }

  .option-label {
    display: block;
    font-size: 11px;
    color: #777;
    margin-bottom: 4px;
  }

  .color-options {
    display: flex;
    width: 100%;
    border: 1px solid #000;
    box-sizing: border-box;
  }

  .color-btn {
    flex: 1;
    padding: 8px 0;
    background: #ffffff;
    color: #000000;
    border: none;
    font-size: 13px;
    cursor: pointer;
    text-align: center;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .color-btn.active {
    background: #000000;
    color: #ffffff;
  }

  .custom-dropdown {
    position: relative;
    width: 100%;
  }

  .dropdown-selected {
    width: 100%;
    padding: 8px 12px;
    border: 1px solid #000;
    background: #fff;
    font-size: 13px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-sizing: border-box;
  }

  .dropdown-arrow {
    font-size: 10px;
    transition: transform 0.2s ease;
  }

  .custom-dropdown.open .dropdown-arrow {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background: #fff;
    border: 1px solid #000;
    border-top: none;
    z-index: 10;
    box-sizing: border-box;
    max-height: 150px;
    overflow-y: auto;
  }

  .custom-dropdown.open .dropdown-menu {
    display: block;
  }

  .dropdown-item {
    padding: 8px 12px;
    font-size: 13px;
    cursor: pointer;
    text-align: center;
  }

  .dropdown-item:hover {
    background: #f0f0f0;
  }

  .dropdown-item.selected {
    background: #000000;
    color: #ffffff;
  }

  .modal-atc-btn {
    width: 100%;
    margin-top: 16px;
    padding: 12px;
    background: #000;
    color: #fff;
    border: none;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
  }

  .modal-atc-btn:disabled {
    background: #ccc;
    cursor: not-allowed;
  }
</style>

{% schema %}
{
  "name": "Tisso Hotspot Grid",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Heading",
      "default": "Tisso vision in the wild"
    }
  ],
  "blocks": [
    {
      "type": "grid_item",
      "name": "Product Block",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image Override (Optional)"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "label": "Hotspot Horizontal (X) Position",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "label": "Hotspot Vertical (Y) Position",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tisso Hotspot Grid",
      "blocks": [
        { "type": "grid_item" },
        { "type": "grid_item" },
        { "type": "grid_item" },
        { "type": "grid_item" },
        { "type": "grid_item" },
        { "type": "grid_item" }
      ]
    }
  ]
}
{% endschema %}