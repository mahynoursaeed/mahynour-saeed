{{ 'custom-hotspot.js' | asset_url | script_tag }}

<div class="hotspot-grid-wrapper">
  <h2 class="grid-title">{{ section.settings.section_title }}</h2>

  <div class="photo-grid">
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}
      <div class="grid-card" {{ block.shopify_attributes }}>
        {% if product != blank and product.featured_image != blank %}
          <img 
            src="{{ product.featured_image | image_url: width: 800 }}" 
            alt="{{ product.title | escape }}" 
            width="{{ product.featured_image.width }}" 
            height="{{ product.featured_image.height }}" 
            loading="lazy" 
            class="grid-img"
          >
        {% elsif block.settings.custom_image != blank %}
          <img 
            src="{{ block.settings.custom_image | image_url: width: 800 }}" 
            alt="{{ block.settings.section_title | escape }}" 
            width="{{ block.settings.custom_image.width }}" 
            height="{{ block.settings.custom_image.height }}" 
            loading="lazy" 
            class="grid-img"
          >
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}

        {% if product != blank %}
          <button 
            type="button"
            class="hotspot-pin" 
            style="top: {{ block.settings.hotspot_y }}%; left: {{ block.settings.hotspot_x }}%;"
            data-product-json='{{ product | json | escape }}'
            aria-label="View {{ product.title | escape }}"
          >
            +
          </button>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

<!-- Modal Popup -->
<div id="hotspot-modal-overlay" class="modal-overlay" aria-hidden="true">
  <div class="modal-box">
    <button type="button" id="modal-close-trigger" class="modal-close-btn" aria-label="Close modal">&times;</button>
    <div class="modal-content">
      <img id="modal-target-img" src="" alt="" width="200" height="240" class="modal-img">
      <div class="modal-info">
        <h3 id="modal-target-title" class="modal-title"></h3>
        <p id="modal-target-price" class="modal-price"></p>
        <div id="modal-target-desc" class="modal-desc"></div>

        <!-- Dynamic Options Container (Rendered via JS) -->
        <div id="modal-options-container"></div>

        <!-- Add to Cart Form -->
        <form id="hotspot-add-to-cart-form">
          <input type="hidden" id="modal-selected-variant-id" name="id" value="">
          <button type="submit" id="modal-atc-submit" class="modal-atc-btn">
            ADD TO CART <span>&rarr;</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const overlay = document.getElementById('hotspot-modal-overlay');
    const closeBtn = document.getElementById('modal-close-trigger');
    const form = document.getElementById('hotspot-add-to-cart-form');
    
    let currentProduct = null;
    let selectedOptions = {};

    // Open Modal
    document.querySelectorAll('.hotspot-pin').forEach(pin => {
      pin.addEventListener('click', function() {
        currentProduct = JSON.parse(this.getAttribute('data-product-json'));
        selectedOptions = {};

        document.getElementById('modal-target-title').innerText = currentProduct.title;
        document.getElementById('modal-target-price').innerText = (currentProduct.price / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD' });
        
        // Strip HTML or keep formatted description
        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = currentProduct.description;
        document.getElementById('modal-target-desc').innerText = tempDiv.innerText || tempDiv.textContent;

        const imgUrl = currentProduct.featured_image || (currentProduct.images && currentProduct.images[0]);
        document.getElementById('modal-target-img').src = imgUrl;

        renderProductOptions(currentProduct);
        overlay.classList.add('active');
        overlay.setAttribute('aria-hidden', 'false');
      });
    });

    // Close Modal
    closeBtn.addEventListener('click', closeModal);
    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) closeModal();
    });

    function closeModal() {
      overlay.classList.remove('active');
      overlay.setAttribute('aria-hidden', 'true');
    }

    // Render Options & Swatches Dynamically
    function renderProductOptions(product) {
      const container = document.getElementById('modal-options-container');
      container.innerHTML = '';

      if (!product.options || product.options.length === 0 || (product.options.length === 1 && product.options[0].name === 'Title')) {
        document.getElementById('modal-selected-variant-id').value = product.variants[0].id;
        return;
      }

      product.options.forEach((option, index) => {
        const optionWrapper = document.createElement('div');
        optionWrapper.className = 'modal-option-group';

        const label = document.createElement('label');
        label.className = 'option-label';
        label.innerText = option.name;
        optionWrapper.appendChild(label);

        // Default selection to first available option value
        selectedOptions[option.name] = option.values[0];

        if (option.name.toLowerCase() === 'color' || option.name.toLowerCase() === 'colour') {
          const colorGroup = document.createElement('div');
          colorGroup.className = 'color-options';
          
          option.values.forEach((val, valIndex) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = `color-btn ${valIndex === 0 ? 'active' : ''}`;
            btn.innerText = val;
            btn.addEventListener('click', function() {
              colorGroup.querySelectorAll('.color-btn').forEach(b => b.classList.remove('active'));
              this.classList.add('active');
              selectedOptions[option.name] = val;
              updateVariantSelection();
            });
            colorGroup.appendChild(btn);
          });
          optionWrapper.appendChild(colorGroup);
        } else {
          const selectWrapper = document.createElement('div');
          selectWrapper.className = 'select-wrapper';
          
          const select = document.createElement('select');
          select.className = 'size-select';

          option.values.forEach(val => {
            const opt = document.createElement('option');
            opt.value = val;
            opt.innerText = val;
            select.appendChild(opt);
          });

          select.addEventListener('change', function() {
            selectedOptions[option.name] = this.value;
            updateVariantSelection();
          });

          selectWrapper.appendChild(select);
          optionWrapper.appendChild(selectWrapper);
        }

        container.appendChild(optionWrapper);
      });

      updateVariantSelection();
    }

    // Match Selected Options to Variant Object
    function updateVariantSelection() {
      const matchedVariant = currentProduct.variants.find(variant => {
        return currentProduct.options.every((opt, idx) => {
          return variant.options[idx] === selectedOptions[opt.name];
        });
      });

      const atcBtn = document.getElementById('modal-atc-submit');
      if (matchedVariant && matchedVariant.available) {
        document.getElementById('modal-selected-variant-id').value = matchedVariant.id;
        atcBtn.disabled = false;
        atcBtn.innerHTML = 'ADD TO CART <span>&rarr;</span>';
      } else {
        document.getElementById('modal-selected-variant-id').value = '';
        atcBtn.disabled = true;
        atcBtn.innerText = 'UNAVAILABLE';
      }
    }

    // Handle AJAX Add to Cart + Bonus Winter Jacket Rule
    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      const variantId = document.getElementById('modal-selected-variant-id').value;
      if (!variantId) return;

      const itemsToAdd = [{ id: parseInt(variantId), quantity: 1 }];

      // Check if chosen options meet requirement: Black + Medium
      const optionValues = Object.values(selectedOptions).map(v => String(v).toLowerCase());
      const isBlackAndMedium = optionValues.includes('black') && (optionValues.includes('medium') || optionValues.includes('m'));

      if (isBlackAndMedium) {
        try {
          const searchRes = await fetch('{{ routes.root_url }}search/suggest.json?q=Soft%20Winter%20Jacket&resources[type]=product');
          const searchData = await searchRes.json();
          const jacketProduct = searchData.resources.results.products[0];

          if (jacketProduct && jacketProduct.variants && jacketProduct.variants[0]) {
            itemsToAdd.push({ id: jacketProduct.variants[0].id, quantity: 1 });
          }
        } catch (err) {
          console.error('Could not auto-add bonus jacket:', err);
        }
      }

      // Execute Cart API Push
      fetch('{{ routes.cart_add_url }}.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: itemsToAdd })
      })
      .then(res => res.json())
      .then(data => {
        closeModal();
        window.location.href = '{{ routes.cart_url }}';
      })
      .catch(err => console.error('Add to cart failed:', err));
    });
  });
</script>

<style>
  .hotspot-grid-wrapper {
    padding: 60px 5%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .grid-title {
    font-size: 28px;
    font-weight: 400;
    margin-bottom: 30px;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  @media (max-width: 768px) {
    .photo-grid {
      grid-template-columns: repeat(1, 1fr);
    }
  }

  .grid-card {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background-color: #f5f5f5;
  }

  .grid-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hotspot-pin {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(0, 0, 0, 0.1);
    font-size: 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }

  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    z-index: 9999;
  }

  .modal-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .modal-box {
    background: #fff;
    padding: 32px 24px 24px;
    max-width: 480px;
    width: 90%;
    position: relative;
  }

  .modal-close-btn {
    position: absolute;
    top: 8px;
    right: 12px;
    background: none;
    border: none;
    font-size: 20px;
    cursor: pointer;
  }

  .modal-content {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 20px;
  }

  @media (max-width: 480px) {
    .modal-content {
      grid-template-columns: 1fr;
    }
  }

  .modal-img {
    width: 100%;
    height: auto;
    aspect-ratio: 4/5;
    object-fit: cover;
  }

  .modal-title {
    font-size: 15px;
    font-weight: 500;
    margin: 0 0 6px;
  }

  .modal-price {
    font-size: 14px;
    margin: 0 0 10px;
  }

  .modal-desc {
    font-size: 11px;
    line-height: 1.4;
    color: #666;
    margin: 0 0 16px;
  }

  .modal-option-group {
    margin-bottom: 12px;
  }

  .option-label {
    display: block;
    font-size: 11px;
    color: #777;
    margin-bottom: 4px;
  }

  .color-options {
    display: flex;
    border: 1px solid #000;
  }

  .color-btn {
    flex: 1;
    padding: 6px 0;
    background: #fff;
    border: none;
    font-size: 12px;
    cursor: pointer;
  }

  .color-btn.active {
    background: #000;
    color: #fff;
  }

  .select-wrapper {
    position: relative;
  }

  .size-select {
    width: 100%;
    padding: 8px 10px;
    border: 1px solid #ccc;
    background: #fff;
    font-size: 12px;
    appearance: none;
    border-radius: 0;
  }

  .select-wrapper::after {
    content: "∨";
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 10px;
    pointer-events: none;
  }

  .modal-atc-btn {
    width: 100%;
    margin-top: 16px;
    padding: 12px;
    background: #000;
    color: #fff;
    border: none;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
  }

  .modal-atc-btn:disabled {
    background: #ccc;
    cursor: not-allowed;
  }
</style>

{% schema %}
{
  "name": "Tisso Hotspot Grid",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Heading",
      "default": "Tisso vision in the wild"
    }
  ],
  "blocks": [
    {
      "type": "grid_item",
      "name": "Product Block",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Grid Image Override (Optional)"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "label": "Hotspot X Position",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "label": "Hotspot Y Position",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tisso Hotspot Grid",
      "blocks": [
        { "type": "grid_item" },
        { "type": "grid_item" },
        { "type": "grid_item" },
        { "type": "grid_item" },
        { "type": "grid_item" },
        { "type": "grid_item" }
      ]
    }
  ]
}
{% endschema %}