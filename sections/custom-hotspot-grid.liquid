{{ 'custom-hotspot.js' | asset_url | script_tag }}

<div class="hotspot-grid-wrapper">
  <h2 class="grid-title">{{ section.settings.section_title }}</h2>

  {% liquid
    if section.settings.collection != blank
      assign catalog_products = section.settings.collection.products
    else
      assign catalog_products = collections.all.products
    endif
  %}

  <div class="photo-grid">
    {% for product in catalog_products limit: section.settings.products_to_show %}
      <div class="grid-card">
        {% if product.featured_image != blank %}
          <img 
            src="{{ product.featured_image | image_url: width: 800 }}" 
            alt="{{ product.title | escape }}" 
            width="{{ product.featured_image.width }}" 
            height="{{ product.featured_image.height }}" 
            loading="lazy" 
            class="grid-img"
          >
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}

        <!-- Hotspot Plus Button -->
        <button 
          type="button"
          class="hotspot-pin" 
          style="top: {{ section.settings.hotspot_y }}%; left: {{ section.settings.hotspot_x }}%;"
          data-title="{{ product.title | escape }}"
          data-price="{{ product.price | money }}"
          data-url="{{ routes.root_url }}products/{{ product.handle }}"
          data-image="{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 500 }}{% endif %}"
          data-description="{{ product.description | strip_html | truncate: 120 | escape }}"
          data-variant-id="{{ product.first_available_variant.id }}"
          aria-label="View item details"
        >
          +
        </button>
      </div>
    {% else %}
      <p>No products found in catalog.</p>
    {% endfor %}
  </div>
</div>

<!-- Modal Popup -->
<div id="hotspot-modal-overlay" class="modal-overlay" aria-hidden="true">
  <div class="modal-box">
    <button type="button" id="modal-close-trigger" class="modal-close-btn" aria-label="Close modal">&times;</button>
    <div class="modal-content">
      <img id="modal-target-img" src="" alt="Product Image" width="200" height="240" class="modal-img">
      <div class="modal-info">
        <h3 id="modal-target-title" class="modal-title"></h3>
        <p id="modal-target-price" class="modal-price"></p>
        <p id="modal-target-desc" class="modal-desc"></p>

        <!-- Color Selector -->
        <div class="modal-option-group">
          <label class="option-label">Color</label>
          <div class="color-options">
            <button type="button" class="color-btn active" data-color="White">White</button>
            <button type="button" class="color-btn" data-color="Black">Black</button>
          </div>
        </div>

        <!-- Size Selector -->
        <div class="modal-option-group">
          <label for="modal-size-select" class="option-label">Size</label>
          <div class="select-wrapper">
            <select id="modal-size-select" class="size-select">
              <option value="" disabled selected>Choose your size</option>
              <option value="S">Small</option>
              <option value="M">Medium</option>
              <option value="L">Large</option>
              <option value="XL">X-Large</option>
            </select>
          </div>
        </div>

        <!-- Add to Cart / Link Button -->
        <form action="{{ routes.cart_add_url }}" method="post" id="hotspot-add-to-cart-form">
          <input type="hidden" name="id" id="modal-variant-id" value="">
          <button type="submit" class="modal-atc-btn">
            ADD TO CART <span>&rarr;</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<style>
  .hotspot-grid-wrapper {
    padding: 60px 5%;
    max-width: 1200px;
    margin: 0 auto;
    font-family: inherit;
  }

  .grid-title {
    font-size: 28px;
    font-weight: 400;
    margin-bottom: 30px;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  @media (max-width: 768px) {
    .photo-grid {
      grid-template-columns: repeat(1, 1fr);
    }
  }

  .grid-card {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background-color: #f5f5f5;
  }

  .grid-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Hotspot Pin Button */
  .hotspot-pin {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(0, 0, 0, 0.1);
    font-size: 16px;
    font-weight: 300;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    transition: transform 0.2s ease;
  }

  .hotspot-pin:hover {
    transform: translate(-50%, -50%) scale(1.15);
  }

  /* Modal Styling */
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    z-index: 9999;
  }

  .modal-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .modal-box {
    background: #fff;
    padding: 32px 24px 24px;
    max-width: 480px;
    width: 90%;
    position: relative;
    border-radius: 0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  }

  .modal-close-btn {
    position: absolute;
    top: 8px;
    right: 12px;
    background: none;
    border: none;
    font-size: 20px;
    cursor: pointer;
    color: #333;
  }

  .modal-content {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 20px;
    align-items: start;
  }

  @media (max-width: 480px) {
    .modal-content {
      grid-template-columns: 1fr;
    }
  }

  .modal-img {
    width: 100%;
    height: auto;
    aspect-ratio: 4/5;
    object-fit: cover;
  }

  .modal-title {
    font-size: 15px;
    font-weight: 500;
    margin: 0 0 6px;
    color: #111;
  }

  .modal-price {
    font-size: 14px;
    font-weight: 400;
    color: #444;
    margin: 0 0 10px;
  }

  .modal-desc {
    font-size: 11px;
    line-height: 1.4;
    color: #666;
    margin: 0 0 16px;
  }

  .modal-option-group {
    margin-bottom: 12px;
  }

  .option-label {
    display: block;
    font-size: 11px;
    color: #777;
    margin-bottom: 4px;
  }

  .color-options {
    display: flex;
    border: 1px solid #000;
  }

  .color-btn {
    flex: 1;
    padding: 6px 0;
    background: #fff;
    border: none;
    font-size: 12px;
    cursor: pointer;
    text-align: center;
    transition: background 0.2s, color 0.2s;
  }

  .color-btn.active {
    background: #000;
    color: #fff;
  }

  .select-wrapper {
    position: relative;
  }

  .size-select {
    width: 100%;
    padding: 8px 10px;
    border: 1px solid #ccc;
    background: #fff;
    font-size: 12px;
    color: #333;
    appearance: none;
    border-radius: 0;
    cursor: pointer;
  }

  .select-wrapper::after {
    content: "∨";
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 10px;
    pointer-events: none;
    color: #555;
  }

  .modal-atc-btn {
    width: 100%;
    margin-top: 16px;
    padding: 12px;
    background: #000;
    color: #fff;
    border: none;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .modal-atc-btn:hover {
    background: #222;
  }
</style>

{% schema %}
{
  "name": "Tisso Hotspot Grid",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Heading",
      "default": "Tisso vision in the wild"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection (Optional)",
      "info": "Leave blank to display all catalog products."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 6,
      "label": "Products to display"
    },
    {
      "type": "range",
      "id": "hotspot_x",
      "min": 5,
      "max": 95,
      "step": 1,
      "unit": "%",
      "label": "Default Hotspot X Position",
      "default": 50
    },
    {
      "type": "range",
      "id": "hotspot_y",
      "min": 5,
      "max": 95,
      "step": 1,
      "unit": "%",
      "label": "Default Hotspot Y Position",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Tisso Hotspot Grid"
    }
  ]
}
{% endschema %}